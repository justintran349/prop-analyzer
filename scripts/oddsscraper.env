# Settings tuned for nba-props-analyzer (see .env.example for every option)
ODDS_SOURCES=draftkings,fanduel,bovada,prizepicks,underdog
SCORE_SOURCES=espn
# Only the sports nba-props-analyzer uses (fewer requests, faster passes)
SPORTS=basketball_nba,americanfootball_nfl,baseball_mlb
RUN_INTERVAL_SECONDS=3600
DFS_NOMINAL_PRICE=1.82
EXTRA_MARKETS=player_props,alternate_spreads
EXTRA_HOURS_AHEAD=48
EXTRA_MAX_EVENTS=25
REQUEST_DELAY_SECONDS=0.4
FANDUEL_STATE=nj
DRAFTKINGS_SITE=dkusnj
