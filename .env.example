# Copy this file to .env and fill in what you want to use.

# Live sportsbook lines + game totals (free tier at https://the-odds-api.com)
ODDS_API_KEY=
ODDS_BOOKMAKERS=draftkings,fanduel,betmgm,caesars

# Phone alerts: install the "ntfy" app, subscribe to a hard-to-guess topic, put it here
NTFY_TOPIC=
ALERT_MIN_EDGE=0.06
ALERT_LINE_MOVE=1.0

# Season = the year the season ENDS (2026-27 -> 2027)
NBA_SEASON=2027
